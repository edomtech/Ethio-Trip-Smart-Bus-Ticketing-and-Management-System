PORT=5000
# For MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ethio_trip?retryWrites=true&w=majority
# For Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/ethio_trip
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Chapa Payment Gateway
CHAPA_SECRET_KEY=your_chapa_secret_key_here
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# Seat hold expiry in minutes
SEAT_HOLD_MINUTES=15

# Set to true only in development to enable mock payment flow (never set true in production)
ENABLE_DEV_MOCK_PAYMENT=false

# Google Gemini AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# OTP security salt (set a random string, keep secret)
OTP_SALT=your_random_otp_salt_here

# SMTP email delivery for registration verification codes.
# The code is always delivered to the address the passenger typed.
# SMTP_USER only authenticates the sender — it is NEVER used as the recipient.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_smtp_app_password
# Must be a real address on the authenticated account (or a configured alias),
# otherwise Gmail rejects every send with a 550 error. Leave blank to use SMTP_USER.
EMAIL_FROM=
# Set true locally to print verification codes to the console. Never in production.
LOG_OTP_IN_CONSOLE=false

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
