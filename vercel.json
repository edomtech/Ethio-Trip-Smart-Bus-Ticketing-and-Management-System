{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://ethio-trip-smart-bus-ticketing-and.onrender.com/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://ethio-trip-smart-bus-ticketing-and.onrender.com/health"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
